[sqlfluff]
dialect = duckdb
templater = jinja
max_line_length = 100
exclude_rules = RF02, RF04, ST06, AM04

[sqlfluff:templater:jinja]
apply_dbt_builtins = True

[sqlfluff:templater:jinja:macros]
known_sum = {% macro known_sum(expression) %} case when count({{ expression }}) = count(*) then sum({{ expression }}) end {% endmacro %}
